<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pass Voyage - L'app qui simplifie vos voyages</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        pv: {
                            primary: '#194474',    /* Bleu PASS */
                            secondary: '#4E9D50',  /* Vert VOYAGE */
                            tertiary: '#ED7E22',   /* Orange */
                            bg: '#F2F7F5',         /* Background */
                            surface: '#F7F7F7',
                            textPrimary: '#1E1E1E',
                            textSecondary: '#757575',
                        }
                    },
                    boxShadow: {
                        'soft': '0 10px 40px -10px rgba(0,0,0,0.08)',
                        'floating': '0 20px 40px -15px rgba(25, 68, 116, 0.15)',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #F2F7F5;
            background-image: radial-gradient(circle at top right, rgba(78, 157, 80, 0.05) 0%, transparent 40%),
                              radial-gradient(circle at bottom left, rgba(25, 68, 116, 0.05) 0%, transparent 40%);
        }
        .glass-nav {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .text-gradient {
            background: linear-gradient(90deg, #194474 0%, #4E9D50 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        /* Float animation for decorative elements */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
        .animate-float {
            animation: float 4s ease-in-out infinite;
        }
        .animate-float-delayed {
            animation: float 4s ease-in-out 2s infinite;
        }
    </style>
</head>
<body class="text-pv-textPrimary antialiased overflow-x-hidden">

    <!-- Navbar -->
    <div class="fixed w-full top-6 z-50 flex justify-center px-4">
        <nav class="glass-nav rounded-full shadow-soft flex items-center justify-between px-6 py-3 w-full max-w-5xl transition-all duration-300 border border-white/50">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-pv-primary flex items-center justify-center text-white font-bold text-lg">P</div>
                <span class="text-xl font-extrabold text-pv-primary tracking-tight">Pass<span class="text-pv-secondary">Voyage</span></span>
            </div>
            
            <div class="hidden md:flex items-center gap-8 text-sm font-medium text-pv-textPrimary">
                <a href="#passagers" class="hover:text-pv-primary transition-colors">Passagers</a>
                <a href="#agents" class="hover:text-pv-primary transition-colors">Agents</a>
                <a href="#compagnies" class="hover:text-pv-primary transition-colors">Compagnies</a>
            </div>
            
            <div class="flex items-center gap-3">
                <a href="#" class="bg-pv-primary hover:bg-blue-900 text-white text-sm font-semibold py-2.5 px-5 rounded-full transition-all shadow-md hover:shadow-lg">
                    Télécharger l'app
                </a>
            </div>
        </nav>
    </div>

    <!-- Hero Section -->
    <section id="passagers" class="relative pt-40 pb-20 lg:pt-48 lg:pb-32 px-4 overflow-hidden max-w-7xl mx-auto flex flex-col lg:flex-row items-center">
        <!-- Text Content -->
        <div class="lg:w-1/2 z-10 text-center lg:text-left">
            <h1 class="text-5xl lg:text-7xl font-extrabold tracking-tight leading-[1.1] mb-6 text-pv-primary">
                Voyagez<br>
                sans limite<span class="text-pv-tertiary">.</span>
            </h1>
            <p class="text-lg lg:text-xl text-pv-textSecondary mb-8 max-w-lg mx-auto lg:mx-0 leading-relaxed">
                Réservation de billets, <strong class="text-pv-tertiary">voyage à crédit</strong> et embarquement instantané. 
                <strong class="text-pv-textPrimary font-semibold">Gérez tous vos trajets depuis votre téléphone, même sans solde immédiat.</strong>
            </p>
            
            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                <a href="#" class="w-full sm:w-auto bg-pv-tertiary hover:bg-orange-600 text-white font-bold py-3.5 px-8 rounded-full transition-all shadow-floating text-center">
                    Ouvrir un compte
                </a>
                <a href="#" class="w-full sm:w-auto bg-white border border-gray-200 text-pv-primary font-bold py-3.5 px-8 rounded-full hover:bg-gray-50 transition-all text-center">
                    Se connecter
                </a>
            </div>
        </div>
        
        <!-- Image Content -->
        <div class="lg:w-1/2 relative mt-16 lg:mt-0 flex justify-center z-0">
            <!-- Decorative floating badges -->
            <div class="absolute top-10 -left-10 bg-white rounded-2xl p-4 shadow-floating animate-float z-20 flex flex-col border border-gray-100 hidden md:flex">
                <span class="text-pv-tertiary font-extrabold text-xl">0 FCFA</span>
                <span class="text-xs font-bold text-gray-400 tracking-wider">AVANCE REQUISE</span>
            </div>
            
            <div class="absolute bottom-20 -right-8 bg-white rounded-2xl p-4 shadow-floating animate-float-delayed z-20 flex items-center gap-3 border border-gray-100 hidden md:flex">
                <div class="w-10 h-10 rounded-full bg-pv-tertiary flex items-center justify-center text-white font-bold">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div class="flex flex-col">
                    <span class="text-pv-textPrimary font-extrabold text-sm">Crédit Voyage</span>
                    <span class="text-xs text-gray-500">Validé en 30s</span>
                </div>
            </div>

            <!-- Phone Mockup -->
            <div class="relative w-72 lg:w-80 z-10 drop-shadow-2xl">
                <!-- Using the passager image -->
                <img src="/images/passager.png" alt="App Passager" class="w-full rounded-[40px] border-[6px] border-black shadow-2xl object-cover bg-white">
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-24 bg-white px-4 relative">
        <div class="max-w-6xl mx-auto text-center">
            <h2 class="text-4xl lg:text-5xl font-extrabold text-pv-primary mb-4 tracking-tight">Une seule app.<br>Tout votre trajet.</h2>
            <p class="text-lg text-pv-textSecondary mb-16 max-w-xl mx-auto">
                Plus besoin de faire la queue ou de chercher vos billets. 
                Pass Voyage rassemble tout dans une interface incroyablement fluide.
            </p>
            
            <div class="grid md:grid-cols-2 gap-8 text-left">
                <!-- Card 1 -->
                <div class="bg-pv-bg rounded-3xl p-10 lg:p-12 transition-transform hover:-translate-y-2 duration-300">
                    <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center mb-6 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-pv-primary"><path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z"/><path d="m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10"/></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-pv-primary mb-3">Réservations instantanées</h3>
                    <p class="text-pv-textSecondary leading-relaxed">
                        Abidjan, Yamoussoukro, Bouaké — peu importe la destination, peu importe la compagnie. 
                        Oubliez les attentes en gare. Achetez votre billet en quelques clics.
                    </p>
                    <a href="#" class="inline-flex items-center text-pv-primary font-bold mt-6 hover:text-pv-secondary transition-colors uppercase text-sm tracking-wide">
                        Découvrir <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                </div>
                
                <!-- Card 2 -->
                <div class="bg-pv-primary rounded-3xl p-10 lg:p-12 text-white transition-transform hover:-translate-y-2 duration-300 relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-64 h-64 bg-white opacity-5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
                    <div class="w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center mb-6 backdrop-blur-sm border border-white/20">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Embarquement fluide</h3>
                    <p class="text-blue-100 leading-relaxed">
                        Un QR Code unique pour chaque voyage. Présentez-le à l'agent de gare pour un scan instantané. 
                        Validation sécurisée et accès direct au car.
                    </p>
                    <a href="#" class="inline-flex items-center text-white font-bold mt-6 hover:text-blue-200 transition-colors uppercase text-sm tracking-wide">
                        Voir comment ça marche <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                </div>
            </div>
            
            <!-- Voyage à crédit Feature card -->
            <div class="mt-8 bg-pv-bg rounded-3xl p-8 lg:p-10 text-left flex flex-col md:flex-row items-center gap-6">
                <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center shrink-0 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-pv-tertiary"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-pv-textPrimary mb-2">Voyagez aujourd'hui, payez à votre rythme</h3>
                    <p class="text-pv-textSecondary text-sm md:text-base">
                        Un imprévu ? Pas assez de fonds sur votre compte Mobile Money ? Aucun problème. Avec notre système de <strong class="text-pv-primary">Voyage à Crédit</strong>, 
                        réservez votre billet immédiatement et remboursez-le plus tard en toute flexibilité via Wave, Orange Money ou MTN.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Agent Section (Agents & Compagnies) -->
    <section id="agents" class="py-24 px-4 bg-pv-bg overflow-hidden relative">
        <div class="max-w-7xl mx-auto flex flex-col-reverse lg:flex-row items-center gap-16">
            <!-- Image -->
            <div class="lg:w-1/2 relative flex justify-center z-10">
                <div class="absolute inset-0 bg-pv-secondary opacity-10 rounded-full blur-3xl transform scale-150"></div>
                <div class="relative w-72 lg:w-80 drop-shadow-2xl">
                    <img src="/images/agent.png" alt="App Agent" class="w-full rounded-[40px] border-[6px] border-black shadow-2xl object-cover bg-white">
                </div>
            </div>
            
            <!-- Text Content -->
            <div id="compagnies" class="lg:w-1/2 z-10 text-center lg:text-left pt-12 lg:pt-0">
                <div class="inline-block bg-pv-secondary/10 text-pv-secondary font-bold px-4 py-1.5 rounded-full text-sm mb-6 uppercase tracking-wider">
                    Pour les compagnies
                </div>
                <h2 class="text-4xl lg:text-5xl font-extrabold text-pv-primary mb-6 tracking-tight">
                    Une application dédiée pour vos agents.
                </h2>
                <p class="text-lg text-pv-textSecondary mb-8">
                    Le module Agent permet un contrôle d'accès ultra-rapide grâce au scanner de QR Code intelligent. 
                    Il vérifie instantanément l'identité du passager et le statut du billet.
                </p>
                <ul class="space-y-4 mb-10 text-left inline-block lg:w-full">
                    <li class="flex items-center gap-3">
                        <div class="w-6 h-6 rounded-full bg-pv-secondary flex items-center justify-center text-white text-xs shrink-0">✓</div>
                        <span class="text-pv-textPrimary font-medium">Scan de billets en moins d'une seconde</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <div class="w-6 h-6 rounded-full bg-pv-secondary flex items-center justify-center text-white text-xs shrink-0">✓</div>
                        <span class="text-pv-textPrimary font-medium">Vérification de la photo du passager</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <div class="w-6 h-6 rounded-full bg-pv-secondary flex items-center justify-center text-white text-xs shrink-0">✓</div>
                        <span class="text-pv-textPrimary font-medium">Historique des embarquements en temps réel</span>
                    </li>
                </ul>
                <a href="#" class="inline-block bg-pv-primary hover:bg-blue-900 text-white font-bold py-3.5 px-8 rounded-full transition-all shadow-md">
                    En savoir plus
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-white pt-20 pb-10 border-t border-gray-100">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-16">
                <!-- Brand -->
                <div class="col-span-1 md:col-span-1">
                    <div class="flex items-center gap-2 mb-6">
                        <div class="w-8 h-8 rounded-full bg-pv-primary flex items-center justify-center text-white font-bold text-lg">P</div>
                        <span class="text-xl font-extrabold text-pv-primary tracking-tight">Pass<span class="text-pv-secondary">Voyage</span></span>
                    </div>
                    <p class="text-sm text-pv-textSecondary mb-6">
                        L'application qui révolutionne le transport interurbain en Côte d'Ivoire. Réservez à crédit, voyagez sans stress et payez à votre rythme.
                    </p>
                    <div class="flex gap-4">
                        <a href="#" class="w-10 h-10 rounded-full bg-pv-bg flex items-center justify-center text-pv-primary hover:bg-pv-primary hover:text-white transition-colors">
                            <!-- FB icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                        </a>
                        <a href="#" class="w-10 h-10 rounded-full bg-pv-bg flex items-center justify-center text-pv-primary hover:bg-pv-primary hover:text-white transition-colors">
                            <!-- Twitter icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
                        </a>
                    </div>
                </div>
                
                <!-- Links -->
                <div>
                    <h4 class="font-bold text-pv-textPrimary mb-4">Produits</h4>
                    <ul class="space-y-3 text-sm text-pv-textSecondary">
                        <li><a href="#" class="hover:text-pv-primary transition-colors">App Passager</a></li>
                        <li><a href="#" class="hover:text-pv-primary transition-colors">App Agent</a></li>
                        <li><a href="#" class="hover:text-pv-primary transition-colors">Dashboard Compagnie</a></li>
                        <li><a href="#" class="hover:text-pv-primary transition-colors">Portefeuille</a></li>
                    </ul>
                </div>
                
                <div>
                    <h4 class="font-bold text-pv-textPrimary mb-4">Ressources</h4>
                    <ul class="space-y-3 text-sm text-pv-textSecondary">
                        <li><a href="#" class="hover:text-pv-primary transition-colors">Centre d'aide</a></li>
                        <li><a href="#" class="hover:text-pv-primary transition-colors">FAQ</a></li>
                        <li><a href="#" class="hover:text-pv-primary transition-colors">Tutoriels</a></li>
                        <li><a href="#" class="hover:text-pv-primary transition-colors">Contact</a></li>
                    </ul>
                </div>
                
                <div>
                    <h4 class="font-bold text-pv-textPrimary mb-4">Légal</h4>
                    <ul class="space-y-3 text-sm text-pv-textSecondary">
                        <li><a href="#" class="hover:text-pv-primary transition-colors">Conditions d'utilisation</a></li>
                        <li><a href="#" class="hover:text-pv-primary transition-colors">Politique de confidentialité</a></li>
                        <li><a href="#" class="hover:text-pv-primary transition-colors">Mentions légales</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="pt-8 border-t border-gray-100 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-pv-textSecondary">
                <p>&copy; 2026 Pass Voyage. Tous droits réservés.</p>
                <div class="flex gap-4">
                    <span>Fait avec passion en Côte d'Ivoire.</span>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
